
##SETUP##

    
    cd ~/ibkr
    python setup_ib.py
    python ib.py accounts


    python ib.py accounts                          ######list configured accounts
    python ib.py USA.PHC test                      ######connection check
    python ib.py USA.PHC holdings                  ######cash, P&L, positions
