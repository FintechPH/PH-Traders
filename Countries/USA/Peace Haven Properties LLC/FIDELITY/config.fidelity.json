{
  "account_name": "Fidelity Account",
  "credentials_env_prefix": "FIDELITY",
  "login_url": "https://digital.fidelity.com/prgw/digital/login/full-page?AuthRedUrl=https://digital.fidelity.com/ftgw/digital/portfolio/positions",
  "positions_url": "https://digital.fidelity.com/ftgw/digital/portfolio/positions",
  "chrome_profile_dir": ".chrome-profile-fidelity",
  "download_dir": "downloads-fidelity",

  "positions_source": "table",

  "timeout_seconds": 30,
  "login_timeout_seconds": 180,
  "table_timeout_seconds": 90,

  "selectors": {
    "login_iframe": "",
    "different_user_link": "xpath://*[self::a or self::button][contains(normalize-space(.), 'different username') or contains(normalize-space(.), 'Use a different')]",
    "username": [
      "#dom-username-input",
      "#userId-input",
      "input[autocomplete='username']",
      "input[id*='user' i]"
    ],
    "password": [
      "#dom-pswd-input",
      "#password",
      "input[type='password']"
    ],
    "submit": [
      "#dom-login-button",
      "#fs-login-button",
      "xpath://*[self::button or self::a][normalize-space(.)='Log in' or normalize-space(.)='Log In']",
      "button[type='submit']"
    ],
    "logged_in_marker": "xpath://*[contains(@class, 'acct-selector__acct-num') or contains(@class, 'ag-pinned-left-cols-container') or contains(@class, 'posweb-grid')][1]",
    "positions_iframe": "",
    "positions_table": "[role='grid'], table"
  },

  "dismiss_if_present": "xpath://*[self::a or self::button][normalize-space()='Remind me later' or normalize-space()='Not now' or normalize-space()='No thanks' or normalize-space()='Continue' or normalize-space()='Got it']",
  "clicks_before_read": [],

  "column_aliases": {
    "market_value": ["Current Value", "market value", "value"],
    "unrealized_pnl": ["Total Gain/Loss Dollar", "unrealized gain/loss", "total gain/loss"]
  },
  "skip_row_pattern": ""
}
